<!DOCTYPE html>
<html lang="hr">
<head>
  <meta charset="UTF-8">
  <title>Web ranjivosti</title>
</head>
<body>
  <h1>Drugi projekt - XSS i Broken Access Control</h1>

  <% if (user) { %>
    <p>Prijavljen kao <b><%= user.username %></b> (uloga: <%= user.role %>)</p>
    <form method="POST" action="/logout"><button>Odjava</button></form>
  <% } else { %>
    <form method="POST" action="/login">
      <input name="username" placeholder="korisničko ime">
      <input name="password" type="password" placeholder="lozinka">
      <button>Prijava</button>
    </form>
    <p><small>Testni korisnici: Roko / Roko123, Frano / Frano123, admin / admin123</small></p>
    <% if (error) { %><p style="color:red"><%= error %></p><% } %>
  <% } %>
  <hr>
  <h2>Cross-site scripting (XSS)</h2>
  <form method="POST" action="/toggle">
    <input type="hidden" name="name" value="xss">
    <label>
      <input type="checkbox" name="on" <%= vuln.xss ? 'checked' : '' %> onchange="this.form.submit()">
      Ranjivost uključena
    </label>
  </form>

  <hr>
  <h2>Loša kontrola pristupa (Broken Access Control)</h2>
  <form method="POST" action="/toggle">
    <input type="hidden" name="name" value="bac">
    <label>
      <input type="checkbox" name="on" <%= vuln.bac ? 'checked' : '' %> onchange="this.form.submit()">
      Ranjivost uključena
    </label>
  </form>
</body>
</html>