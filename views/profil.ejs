<!DOCTYPE html>
<html lang="hr">
<head>
  <meta charset="UTF-8">
  <title>Profil - <%= profil.username %></title>
</head>
<body>
  <p>Prijavljen kao <b><%= user.username %></b> (ID: <%= user.id %>, uloga: <%= user.role %>)</p>
  <h1>Profil korisnika: <%= profil.username %></h1>

  <% if (profil.id !== user.id) { %>
    <p style="color:red"><b>Gledaš TUĐI profil!</b></p>
  <% } %>

  <table border="1" cellpadding="6">
    <tr><th>ID</th><td><%= profil.id %></td></tr>
    <tr><th>Korisničko ime</th><td><%= profil.username %></td></tr>
    <tr><th>Uloga</th><td><%= profil.role %></td></tr>
    <tr><th>E-mail</th><td><%= profil.email %></td></tr>
    <tr><th>OIB</th><td><%= profil.oib %></td></tr>
    <tr><th>Adresa</th><td><%= profil.adresa %></td></tr>
  </table>

  <p><a href="/">&larr; Natrag na početnu</a></p>
</body>
</html>
